# User crontab (crontab -e), not /etc/crontab. Adjust paths before installing.
# Create /home/roomgap/RoomGap/logs first. Times use the server's local timezone.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Refresh existing schedules every Sunday at 03:00.
0 3 * * 0 cd /home/roomgap/RoomGap && ROOMGAP_AUTH_DAEMON=1 ./run-collect.sh >> /home/roomgap/RoomGap/logs/collect.log 2>&1

# Retry a commit left behind by a transient GitHub outage without recollecting.
# Avoid :00 and :30 to reduce contention with scheduled starts; a longer collection
# can still hold the lock, in which case the next push-only cron will try again.
5,35 * * * * cd /home/roomgap/RoomGap && ROOMGAP_GIT_PUSH_ONLY=1 ./run-collect.sh >> /home/roomgap/RoomGap/logs/push.log 2>&1
