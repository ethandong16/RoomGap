# Copy to ~/.config/roomgap.env and chmod 600. Bash syntax; never commit real keys.
# Existing root deployments use /root/.config/roomgap.env.
ROOMGAP_HEADLESS=1
ROOMGAP_MIN_FREE_MB=128

# Optional: runner auto-detects a system browser and the repository's cookie file.
# ROOMGAP_BROWSER_EXECUTABLE='/usr/bin/chromium'
# ROOMGAP_BROWSER_PROFILE='/absolute/path/to/.roomgap-browser'
# ROOMGAP_COOKIES_FILE='/absolute/path/to/.roomgap-auth.json'

# Base device URL, without the example /Body suffix. Empty disables notifications.
ROOMGAP_BARK_URL=''
# ROOMGAP_BARK_URL='https://api.day.app/YOUR_DEVICE_KEY'

# Publish verified data to origin/main. Requires a repository-scoped write deploy
# key, Git author identity and an empty staging area.
ROOMGAP_GIT_PUSH=1
ROOMGAP_GIT_PUSH_ATTEMPTS=5
ROOMGAP_GIT_PUSH_RETRY_SECONDS=15

# Leave ROOMGAP_REFRESH out for the default full refresh. Set it to 0 only when
# explicitly resuming an interrupted collection.
# Node.js must be on the cron user's PATH; if installed elsewhere, set PATH here.
# PATH='/opt/node22/bin:/usr/local/bin:/usr/bin:/bin'
