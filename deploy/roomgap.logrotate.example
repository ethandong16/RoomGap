# Administrator: adapt both paths and the account, then place in /etc/logrotate.d/roomgap.
# Use "su root root" and /var/log/roomgap-collect*.log for the existing root install.
/home/roomgap/RoomGap/logs/*.log {
  su roomgap roomgap
  daily
  maxsize 1M
  rotate 3
  compress
  delaycompress
  missingok
  notifempty
  copytruncate
}
